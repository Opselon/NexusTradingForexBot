# ============================================================
# Nexus Scalp Engine — .env.example
# ============================================================
# Copy to .env for local overrides:   cp .env.example .env
# Every variable here is OPTIONAL (safe defaults exist in
# docker-compose.yml). Only touch what you need to change.
# NEVER commit .env — it is git-ignored. Secrets (Telegram bot
# token, broker credentials) are NOT listed here on purpose;
# supply them at runtime via the runtime configuration/settings
# store or environment variables, never in this file.

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
# Engine execution mode inside the container: PAPER (default, simulates
# execution in-memory) | SHADOW (signal-only) | LIVE (requires a
# reachable MT5 host — NOT supported inside the Linux container).
NSE_EXECUTION__MODE=PAPER

# Trading symbol served by the engine (XAUUSD | EURUSD | ...).
NSE_EXECUTION__SYMBOL=XAUUSD

# Web/API port exposed on the host (container port stays 9090).
NSE_WEB_PORT=9090

# Internal log level (DEBUG | INFO | WARNING | ERROR).
NSE_LOG_LEVEL=INFO

# Container timezone (defaults to UTC — keep UTC for trading/intraday
# consistency unless you have a specific reason to diverge).
TZ=UTC

# ------------------------------------------------------------
# Model
# ------------------------------------------------------------
# Container model artifact path (inside /app). The file must live under
# the nexus-artifacts volume; mount a pre-trained bundle into
# artifacts/models if you want a specific model loaded at boot.
NSE_MODEL__MODEL_ARTIFACT_PATH=artifacts/models/scalp/XAUUSD/v1.0.0/model.pt

# ------------------------------------------------------------
# Risk (safe development defaults — NEVER raise these blindly)
# ------------------------------------------------------------
# Maximum account drawdown (% of equity) before the engine halts.
NSE_RISK__MAX_ACCOUNT_DRAWDOWN_PCT=2.0

# Risk per trade (% of equity).
NSE_RISK__RISK_PER_TRADE_PCT=0.5

# ------------------------------------------------------------
# Optional subsystems
# ------------------------------------------------------------
# News intelligence (enabled by default; degrades gracefully when the
# news provider is unreachable).
NSE_NEWS__ENABLED=true

# Telegram notifications (disabled by default in containers — configure
# the bot token/chat id through the Web UI Settings, or via
# NEXUS_TELEGRAM_BOT_TOKEN / NEXUS_TELEGRAM_ADMIN_ID env at runtime).
NSE_TELEGRAM__ENABLED=false