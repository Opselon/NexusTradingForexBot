+.compare .check{color:var(--ok); font-weight:900} .compare .cross{color:var(--muted)}
+
+/* -- Timeline premium -- */
+.timeline-premium{position:relative; padding-inline-start:22px; margin:18px 0}
+.timeline-premium::before{content:""; position:absolute; inset:0 auto 0 7px; width:2px; background:linear-gradient(var(--accent),var(--accent-2)); opacity:.18; border-radius:999px}
+.tl-row{position:relative; display:grid; grid-template-columns:120px 1fr; gap:14px; padding:12px 0; border-top:1px dashed var(--border)} .tl-row:first-child{border-top:0}
