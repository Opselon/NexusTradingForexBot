+.related-card p{margin:0; color:var(--muted); font-size:.9rem; line-height:1.5}
+
+/* -- Kbd, tooltips -- */
+kbd{font-family:var(--font-mono); font-size:.78em; padding:2px 6px; border:1px solid var(--border); border-bottom-width:2px; border-radius:6px; background:var(--card); color:var(--fg); box-shadow:var(--shadow); font-weight:700}
+.btn:focus-visible, a:focus-visible{outline:2px solid var(--accent); outline-offset:2px}
+
+/* -- Command palette polish -- */
+.cmdk-hint{padding:8px 14px; font-size:.78rem; color:var(--muted); border-top:1px solid var(--border); background:var(--bg-2); display:flex; gap:10px; flex-wrap:wrap}
+
+/* -- Back-to-top -- */
+.to-top{position:fixed; inset-inline-end:16px; inset-block-end:16px; width:42px; height:42px; border-radius:50%; display:grid; place-items:center; background:var(--card); border:1px solid var(--border); box-shadow:var(--shadow-lg); cursor:pointer; opacity:0; pointer-events:none; transform:translateY(8px); transition:all var(--dur-fast) var(--ease); z-index:20}
+.to-top.is-visible{opacity:1; pointer-events:auto; transform:none}
+.to-top:hover{border-color:var(--accent); color:var(--accent)}
+
+/* -- System diagram -- */
+.sys-diagram{border:1px solid var(--border); border-radius:16px; background:var(--card); box-shadow:var(--shadow); overflow:hidden; margin:16px 0}
+.sys-diagram-head{display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 14px; border-bottom:1px solid var(--border); background:linear-gradient(180deg,var(--card),var(--bg-2))}
+.sys-diagram-head b{font-size:.9rem}
+.sys-diagram-body{padding:14px; background:var(--bg-2); overflow:auto}
+.flow-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:10px; margin:14px 0}
+.flow-node{border:1px solid var(--border); border-radius:12px; background:var(--card); padding:12px; text-align:center; font-weight:800; font-size:.88rem; position:relative}
+.flow-node small{display:block; font-weight:600; color:var(--muted); margin-top:4px; font-size:.8rem}
+
+/* -- Feature list -- */
+.pill-list{display:flex; flex-wrap:wrap; gap:8px; margin:10px 0}
+.feature-list{display:grid; gap:10px; margin:14px 0}
+.feature-item{display:grid; grid-template-columns:36px 1fr; gap:12px; padding:12px; border:1px solid var(--border); border-radius:12px; background:var(--card)}
+.feature-item .fi-ic{width:36px; height:36px; border-radius:10px; display:grid; place-items:center; background:var(--accent-soft); border:1px solid color-mix(in srgb,var(--accent) 14%,transparent)}
+.feature-item h4{margin:0 0 4px; font-size:.98rem} .feature-item p{margin:0; color:var(--muted); font-size:.9rem}
+
+/* -- Notices -- */
+.notice{border:1px solid var(--border); border-radius:14px; padding:14px 16px; background:var(--card); display:flex; gap:12px; align-items:start; margin:16px 0}
+.notice .n-ic{width:34px; height:34px; border-radius:10px; display:grid; place-items:center; flex:0 0 auto; background:var(--bg-2); border:1px solid var(--border)}
+.notice-warn{border-color:color-mix(in srgb,var(--warn) 22%,var(--border)); background:color-mix(in srgb,var(--warn) 8%,var(--card))}
+.notice-info{border-color:color-mix(in srgb,var(--accent) 18%,var(--border)); background:color-mix(in srgb,var(--accent) 8%,var(--card))}
+
+/* -- Progress + skeleton + shimmer -- */
+.shimmer{position:relative; overflow:hidden}
+.shimmer::after{content:""; position:absolute; inset:0; background:linear-gradient(90deg, transparent, rgba(255,255,255,.18), transparent); transform:translateX(-100%); animation:shimmer 1.6s infinite}
+@keyframes shimmer{to{transform:translateX(100%)}}
+.reveal.delay-1{transition-delay:.06s} .reveal.delay-2{transition-delay:.12s} .reveal.delay-3{transition-delay:.18s} .reveal.delay-4{transition-delay:.24s}
+@media print{ .page-hero{box-shadow:none} }
+@media (prefers-reduced-motion:reduce){ .shimmer::after{display:none} .hero-pro::before{opacity:.12} }
+
+/* -- Motion library -- */
+@keyframes fadeIn{from{opacity:0} to{opacity:1}}
+@keyframes fadeInUp{from{opacity:0; transform:translateY(10px)} to{opacity:1; transform:none}}
+@keyframes fadeInDown{from{opacity:0; transform:translateY(-10px)} to{opacity:1; transform:none}}
+@keyframes zoomIn{from{opacity:0; transform:scale(.96)} to{opacity:1; transform:scale(1)}}
+@keyframes slideInLeft{from{opacity:0; transform:translateX(-12px)} to{opacity:1; transform:none}}
+@keyframes slideInRight{from{opacity:0; transform:translateX(12px)} to{opacity:1; transform:none}}
+@keyframes float{0%,100%{transform:translateY(0)} 50%{transform:translateY(-6px)}}
+@keyframes glowPulse{0%,100%{box-shadow:0 0 0 0 var(--accent-glow)} 50%{box-shadow:0 0 0 8px transparent}}
+@keyframes spin{to{transform:rotate(360deg)}}
+@keyframes ping{75%,100%{transform:scale(1.4); opacity:0}}
+/* -- Utilities -- */
+.u-flex{display:flex} .u-inline-flex{display:inline-flex} .u-grid{display:grid} .u-hidden{display:none!important}
+.u-items-center{align-items:center} .u-justify-center{justify-content:center} .u-justify-between{justify-content:space-between}
+.u-gap-1{gap:4px} .u-gap-2{gap:8px} .u-gap-3{gap:12px} .u-gap-4{gap:16px} .u-gap-6{gap:24px}
+.u-p-2{padding:8px} .u-p-3{padding:12px} .u-p-4{padding:16px} .u-p-6{padding:24px}
+.u-muted{color:var(--muted)} .u-accent{color:var(--accent)}
+.u-rounded{border-radius:var(--radius)} .u-rounded-full{border-radius:999px}
+.u-border{border:1px solid var(--border)} .u-shadow{box-shadow:var(--shadow)}
+.u-bg-card{background:var(--card)} .u-bg-soft{background:var(--bg-2)}
+.u-truncate{overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
+.u-clamp-2{display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden}
+/* -- Buttons pro variants -- */
+.btn-sm{padding:7px 12px; font-size:.84rem; border-radius:9px}
+.btn-xl{padding:14px 26px; font-size:1.06rem; border-radius:14px}
+.btn-accent{background:var(--pro-gradient); color:#fff; border-color:transparent; box-shadow:0 8px 22px var(--accent-glow)}
+.btn-accent:hover{filter:brightness(1.06); transform:translateY(-1px)}
+.btn-outline{background:transparent; border-color:var(--border); color:var(--fg)} .btn-outline:hover{border-color:var(--accent); color:var(--accent); background:var(--accent-soft)}
+.btn-quiet{background:transparent; border-color:transparent; box-shadow:none; color:var(--muted)} .btn-quiet:hover{background:var(--bg-2); color:var(--fg)}
+.btn-icon{width:38px; height:38px; padding:0; border-radius:10px; display:grid; place-items:center}
+.btn-group{display:inline-flex; gap:0; border:1px solid var(--border); border-radius:11px; overflow:hidden; background:var(--card); box-shadow:var(--shadow)}
+.btn-group .btn{border:0; border-radius:0; box-shadow:none} .btn-group .btn + .btn{border-inline-start:1px solid var(--border)}
+/* -- Cards premium -- */
+.card{border:1px solid var(--border); border-radius:16px; background:var(--card); box-shadow:var(--shadow); overflow:hidden; transition:all var(--dur-fast) var(--ease)}
+.card:hover{transform:translateY(-2px); box-shadow:var(--shadow-md); border-color:color-mix(in srgb,var(--accent) 14%,var(--border))}
+.card-head{display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 16px; border-bottom:1px solid var(--border); background:linear-gradient(180deg,var(--card),var(--bg-2))}
+.card-body{padding:16px} .card-foot{padding:12px 16px; border-top:1px solid var(--border); background:var(--bg-2); display:flex; gap:10px; flex-wrap:wrap}
+.card-highlight{border-color:color-mix(in srgb,var(--accent) 22%,var(--border)); box-shadow:var(--shadow-glow)}
+/* -- Pricing/stats/testimonials/FAQ/newsletter -- */
+.pricing{display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:14px; margin:18px 0}
+.price-card{border:1px solid var(--border); border-radius:16px; background:var(--card); padding:20px; position:relative; overflow:hidden}
+.price-card.featured{border-color:var(--accent); box-shadow:var(--shadow-glow)}
+.price{font-size:2rem; font-weight:900; letter-spacing:-.03em} .price small{font-size:.9rem; color:var(--muted)}
+.quote{border:1px solid var(--border); border-radius:16px; background:var(--card); padding:16px}
+.faq{border:1px solid var(--border); border-radius:14px; overflow:hidden; background:var(--card)}
+.faq-item{border-top:1px solid var(--border)} .faq-item:first-child{border-top:0}
+.faq-q{width:100%; display:flex; justify-content:space-between; align-items:center; gap:12px; padding:14px 16px; background:transparent; border:0; font-weight:800; cursor:pointer}
+.faq-a{padding:0 16px 16px; color:var(--muted); display:none} .faq-item.is-open .faq-a{display:block}
+.newsletter{border:1px solid var(--border); border-radius:16px; background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 10%,var(--card)),var(--card)); padding:18px}
+.newsletter input{flex:1 1 220px; padding:10px 12px; border:1px solid var(--border); border-radius:10px; background:var(--card); color:var(--fg)}
+/* -- Footer premium -- */
+.site-footer{border-top:1px solid var(--border); background:linear-gradient(180deg,var(--bg),var(--card)); padding:28px 18px 18px; margin-top:40px}
+.footer-grid{display:grid; grid-template-columns:1.2fr .8fr .8fr .8fr; gap:22px; max-width:var(--content-max); margin:0 auto}
+.footer-grid h4{margin:0 0 10px; font-size:.84rem; letter-spacing:.08em; text-transform:uppercase; color:var(--muted)}
+/* -- Scrollbar + lightbox + sort + helpers -- */
+*{scrollbar-width:thin; scrollbar-color:var(--border) transparent}
+*::-webkit-scrollbar{width:8px; height:8px} *::-webkit-scrollbar-thumb{background:var(--border); border-radius:999px}
+.lightbox{position:fixed; inset:0; background:var(--overlay); backdrop-filter:blur(10px); display:none; place-items:center; padding:18px; z-index:60}
+.lightbox.open{display:grid} .lightbox img{max-width:min(92vw,1100px); max-height:88vh; border-radius:16px; box-shadow:var(--shadow-lg)}
+.th-sort{cursor:pointer; user-select:none} .reveal-fast{transition-duration:.32s}
+.hide-mobile{display:block} .show-mobile{display:none} @media(max-width:900px){.hide-mobile{display:none} .show-mobile{display:block}}
+.grid-2{display:grid; grid-template-columns:repeat(2,1fr); gap:12px} @media(max-width:700px){.grid-2{grid-template-columns:1fr}}
+.grid-3{display:grid; grid-template-columns:repeat(3,1fr); gap:12px} @media(max-width:900px){.grid-3{grid-template-columns:1fr}}
+.prose :not(pre)>code{font-weight:600} .hero-pro{animation:fadeIn .5s var(--ease) both}
+
