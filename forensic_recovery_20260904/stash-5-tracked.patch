+  padding:28px 24px 22px; margin:6px 0 22px; box-shadow:var(--shadow-md);
+}
+.page-hero::before{
+  content:""; position:absolute; inset:0;
+  background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
+  background-size:28px 28px; opacity:.35; pointer-events:none;
+  mask-image:radial-gradient(70% 90% at 60% 0%, #000 30%, transparent 75%);
+}
+.page-hero > *{position:relative}
+.page-hero .ph-kicker{font-size:.7rem; letter-spacing:.16em; font-weight:800; text-transform:uppercase; color:var(--accent); display:flex; align-items:center; gap:8px; margin-bottom:8px}
+.page-hero .ph-kicker i{width:28px; height:28px; border-radius:9px; display:grid; place-items:center; background:var(--accent-soft); border:1px solid color-mix(in srgb,var(--accent) 16%,transparent)}
+.page-hero h1{margin:0 0 8px; font-size:clamp(1.75rem,3vw,2.35rem); line-height:1.05; letter-spacing:-.03em}
+.page-hero .ph-sub{color:var(--muted); max-width:72ch; margin:0; line-height:1.65; font-size:1rem}
+.page-hero .ph-actions{display:flex; flex-wrap:wrap; gap:10px; margin-top:14px}
+.page-hero.variant-project{border-color:color-mix(in srgb,#f59e0b 18%,var(--border))}
+.page-hero.variant-research{border-color:color-mix(in srgb,var(--exp) 18%,var(--border))}
+.page-hero.variant-engineering{border-color:color-mix(in srgb,#06b6d4 16%,var(--border))}
+.page-hero.variant-guides{border-color:color-mix(in srgb,var(--ok) 16%,var(--border))}
+.page-hero.variant-contributing{border-color:color-mix(in srgb,#ec4899 14%,var(--border))}
+
+/* -- Right TOC (desktop) -- */
+.toc{border:1px solid var(--border); border-radius:14px; background:var(--card); box-shadow:var(--shadow); overflow:hidden; position:sticky; top:calc(var(--header-h) + 14px)}
+.toc-head{display:flex; align-items:center; justify-content:space-between; padding:12px 14px; border-bottom:1px solid var(--border); background:linear-gradient(180deg,var(--card),var(--bg-2)); font-weight:800; font-size:.84rem; letter-spacing:.04em; text-transform:uppercase; color:var(--muted)}
+.toc-list{list-style:none; margin:0; padding:8px}
+.toc-list li{margin:1px 0}
+.toc-list a{display:block; padding:7px 10px; border-radius:9px; color:var(--muted); font-size:.88rem; line-height:1.45; border:1px solid transparent}
+.toc-list a:hover{background:var(--bg-2); color:var(--fg); text-decoration:none}
+.toc-list a.is-active{background:var(--accent-soft); color:var(--accent); border-color:color-mix(in srgb,var(--accent) 16%,transparent); font-weight:700}
+.toc-list .lvl-3{padding-inline-start:18px; font-size:.84rem; opacity:.9}
+.toc-empty{padding:12px 14px; color:var(--muted); font-size:.9rem}
+.toc-mobile{border:1px solid var(--border); border-radius:12px; background:var(--card); padding:6px; margin:10px 0 16px; display:none}
+.toc-mobile summary{cursor:pointer; list-style:none; padding:10px 12px; border-radius:8px; font-weight:700; display:flex; align-items:center; justify-content:space-between}
+.toc-mobile summary::-webkit-details-marker{display:none}
+.toc-mobile[open] summary{background:var(--bg-2)}
+.doc-layout{display:grid; grid-template-columns:minmax(0,1fr) 280px; gap:22px; align-items:start}
+@media (max-width:1100px){ .doc-layout{grid-template-columns:1fr} .toc{display:none} .toc-mobile{display:block} }
+
+/* -- Premium callouts -- */
+.callout{position:relative; overflow:hidden}
+.callout::after{content:""; position:absolute; inset:0 0 auto 0; height:1px; background:linear-gradient(90deg,var(--accent),transparent); opacity:.18}
+.callout-info{border-inline-start-color:var(--accent)} .callout-info .callout-title{color:var(--accent)}
+.callout-tip{border-inline-start-color:var(--ok)} .callout-tip .callout-title{color:var(--ok)}
+.callout-warning{border-inline-start-color:var(--warn)} .callout-warning .callout-title{color:var(--warn)}
+.callout-important{border-inline-start-color:var(--exp)} .callout-important .callout-title{color:var(--exp)}
+.callout-danger{border-inline-start-color:var(--danger)} .callout-danger .callout-title{color:var(--danger)}
+.callout .callout-title{display:flex; align-items:center; gap:8px}
+.callout p{margin:.5em 0}
+.callout code{background:color-mix(in srgb,var(--bg-3) 85%, var(--card))}
+
+/* -- Code premium -- */
+.codeblock{border-radius:14px; overflow:hidden; border:1px solid rgba(255,255,255,.08); box-shadow:var(--shadow-md)}
+.code-head{display:flex; align-items:center; justify-content:space-between; gap:10px; padding:8px 12px; background:rgba(255,255,255,.06); border-bottom:1px solid rgba(255,255,255,.08); color:#94a3b8; font-size:.78rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase}
+.code-head .lang{padding:3px 8px; border-radius:999px; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.1); color:#cbd5e1; font-weight:800}
+.code-ln{counter-reset:ln}
+.code-ln span{display:block; counter-increment:ln}
+.code-ln span::before{content:counter(ln); display:inline-block; width:28px; margin-inline-end:10px; text-align:right; color:#475569; user-select:none; font-variant-numeric:tabular-nums}
+
+/* -- Tabs -- */
+.tabs{border:1px solid var(--border); border-radius:14px; overflow:hidden; background:var(--card); box-shadow:var(--shadow)}
+.tab-bar{display:flex; gap:6px; padding:8px; background:var(--bg-2); border-bottom:1px solid var(--border); overflow-x:auto}
+.tab-bar button{padding:8px 14px; border-radius:999px; border:1px solid var(--border); background:var(--card); font-weight:700; cursor:pointer; white-space:nowrap; transition:all var(--dur-fast) var(--ease); color:var(--fg)}
+.tab-bar button.is-active{background:var(--accent); color:#fff; border-color:var(--accent); box-shadow:0 6px 16px var(--accent-glow)}
+.tab-panel{padding:16px; display:none} .tab-panel.is-active{display:block}
+
+/* -- Accordions -- */
+.accordion{border:1px solid var(--border); border-radius:14px; overflow:hidden; background:var(--card); box-shadow:var(--shadow)}
+.accordion-item{border-top:1px solid var(--border)} .accordion-item:first-child{border-top:0}
+.accordion-trigger{width:100%; display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 16px; background:transparent; border:0; text-align:start; cursor:pointer; font-weight:800; color:var(--fg)}
+.accordion-trigger:hover{background:var(--bg-2)}
+.accordion-panel{padding:0 16px 16px; color:var(--muted); display:none} .accordion-item.is-open .accordion-panel{display:block}
+.acc-icon{width:28px; height:28px; border-radius:8px; display:grid; place-items:center; border:1px solid var(--border); background:var(--card); transition:transform var(--dur-fast) var(--ease)} .accordion-item.is-open .acc-icon{transform:rotate(45deg); border-color:var(--accent); color:var(--accent)}
+
+/* -- Data tables premium -- */
+.table-premium table{font-size:.9rem}
+.table-premium th{position:sticky; top:0; backdrop-filter:blur(8px)}
+.table-premium td code{font-size:.82em}
+.table-premium tr.is-highlight td{background:color-mix(in srgb,var(--accent) 8%, var(--card))}
+.badge{display:inline-flex; align-items:center; gap:6px; padding:3px 9px; border-radius:999px; font-size:.72rem; font-weight:800; letter-spacing:.04em; border:1px solid var(--border); background:var(--card)}
+.badge-ok{color:var(--ok); border-color:color-mix(in srgb,var(--ok) 28%,var(--border)); background:var(--ok-soft)}
+.badge-warn{color:var(--warn); border-color:color-mix(in srgb,var(--warn) 28%,var(--border)); background:var(--warn-soft)}
+.badge-exp{color:var(--exp); border-color:color-mix(in srgb,var(--exp) 28%,var(--border)); background:var(--exp-soft)}
+.badge-neutral{color:var(--muted); background:var(--bg-2)}
+
+/* -- Stats -- */
+.stat-row{display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px; margin:16px 0}
+.stat-card{border:1px solid var(--border); border-radius:14px; background:var(--card); padding:16px; text-align:center; position:relative; overflow:hidden}
+.stat-card::before{content:""; position:absolute; inset:auto -20% -40% auto; width:70%; height:70%; background:radial-gradient(circle,var(--accent-soft),transparent 70%); opacity:.7; pointer-events:none}
+.stat-card b{font-size:1.6rem; font-weight:900; letter-spacing:-.03em; display:block}
+.stat-card span{font-size:.76rem; color:var(--muted); font-weight:700; letter-spacing:.06em; text-transform:uppercase}
+
+/* -- Comparison -- */
