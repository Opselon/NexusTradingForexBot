+
+/* ═══════════════════════════════════════════════════════════════════
+   NEXUS FLAGSHIP — PREMIUM EXPANSION (9000-line build)
+   Cinematic SaaS · glass · mesh · motion · full subpage suite
+   Covers: article, TOC, code, callouts, tabs, accordions,
+   data tables, timeline, stats, comparison, kbd, tooltips,
+   command palette polish, lightbox, print, RTL, a11y
+   ═══════════════════════════════════════════════════════════════════ */
+
+/* -- Extended tokens -- */
+:root{
+  --ok-soft:color-mix(in srgb,var(--ok) 12%, var(--card));
+  --warn-soft:color-mix(in srgb,var(--warn) 12%, var(--card));
+  --danger-soft:color-mix(in srgb,var(--danger) 10%, var(--card));
+  --exp-soft:color-mix(in srgb,var(--exp) 11%, var(--card));
+  --surface:#ffffff;
+  --surface-2:var(--bg-2);
+  --ink:var(--fg);
+  --ink-muted:var(--muted);
+  --focus:var(--accent);
+  --grid:color-mix(in srgb,var(--border) 70%, transparent);
+  --overlay:rgba(2,6,23,.56);
+  --pro-gradient:linear-gradient(135deg,var(--accent),var(--accent-2) 55%,var(--accent-3));
+  --pro-gradient-soft:linear-gradient(135deg,color-mix(in srgb,var(--accent) 14%,transparent),color-mix(in srgb,var(--accent-2) 14%,transparent));
+  --hero-mesh: radial-gradient(1100px 520px at 78% -8%, color-mix(in srgb,var(--accent) 18%,transparent) 0%, transparent 60%),
+               radial-gradient(900px 460px at 8% 108%, color-mix(in srgb,var(--accent-2) 16%,transparent) 0%, transparent 62%),
+               radial-gradient(700px 400px at 92% 60%, color-mix(in srgb,var(--accent-3) 12%,transparent) 0%, transparent 58%);
+}
+:root[data-theme="dark"]{
+  --surface:#0f172a;
+  --surface-2:#0b1220;
+  --overlay:rgba(2,6,23,.72);
+}
+
+/* -- Pro article typography -- */
+.prose{max-width:78ch; line-height:1.78; color:var(--fg)}
+.prose h2{position:relative; scroll-margin-top:calc(var(--header-h) + 16px); padding-right:28px}
+.prose h3{scroll-margin-top:calc(var(--header-h) + 16px)}
+.prose h2 .anchor,.prose h3 .anchor{
+  position:absolute; inset-inline-end:0; top:50%; transform:translateY(-50%);
+  width:26px; height:26px; border-radius:8px; display:grid; place-items:center;
+  border:1px solid var(--border); background:var(--card); color:var(--muted);
+  font-size:13px; opacity:0; transition:opacity var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
+  text-decoration:none;
+}
+.prose h2:hover .anchor,.prose h3:hover .anchor,.anchor:focus{opacity:1; border-color:var(--accent)}
+.prose p{margin:1em 0; color:var(--fg)}
+.prose p.lead{font-size:1.14rem; color:var(--muted); line-height:1.7; max-width:70ch}
+.prose a{font-weight:600; text-underline-offset:3px; text-decoration-thickness:1.5px}
+.prose a:hover{text-decoration:underline}
+.prose strong{font-weight:800; letter-spacing:-.01em}
+.prose hr{border:0; height:1px; background:var(--border); margin:2em 0}
+.prose ul,.prose ol{padding-inline-start:1.4em; margin:1em 0}
+.prose li{margin:.45em 0}
+.prose li::marker{color:var(--accent)}
+.prose figure{margin:1.6em 0; border:1px solid var(--border); border-radius:16px; overflow:hidden; background:var(--card); box-shadow:var(--shadow)}
+.prose figcaption{padding:10px 14px; font-size:.84rem; color:var(--muted); background:var(--bg-2); border-top:1px solid var(--border); text-align:center}
+.prose img{border-radius:12px}
+.prose .kicker{font-size:.72rem; letter-spacing:.16em; font-weight:800; color:var(--accent); text-transform:uppercase; margin-bottom:6px}
+.prose .eyebrow{display:inline-flex; gap:8px; align-items:center; font-size:.72rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; color:var(--accent); background:var(--accent-soft); border:1px solid color-mix(in srgb,var(--accent) 18%,transparent); padding:4px 10px; border-radius:999px}
+.reading-meta{display:flex; flex-wrap:wrap; gap:10px; align-items:center; color:var(--muted); font-size:.86rem; margin:8px 0 18px}
+.reading-meta .dot{width:4px; height:4px; border-radius:50%; background:var(--border-2)}
+.reading-meta .badge-read{padding:3px 9px; border-radius:999px; border:1px solid var(--border); background:var(--card); font-weight:700; font-size:.78rem}
+
+/* -- Page hero variants (per section) -- */
+.page-hero{
+  border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden; position:relative;
+  background: var(--card);
